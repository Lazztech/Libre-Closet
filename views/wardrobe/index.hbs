{{>navbar}}

<main class="p-4 pt-20 pb-40">
  <div class="flex items-center justify-between mb-6 px-2">
    <h1 class="text-2xl font-bold">{{t 'lang.WARDROBE'}}</h1>
    {{#if canEdit}}
    <a href="/wardrobe/new{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-primary btn-sm">+ {{t 'lang.NEW_GARMENT'}}</a>
    {{/if}}
  </div>

  {{!-- Shared wardrobe switcher --}}
  {{#if sharedWardrobes.length}}
  <div class="mb-4 px-2">
    <select class="select select-bordered select-sm w-full" onchange="location.href=this.value">
      <option value="/wardrobe" {{#unless viewOwner}}selected{{/unless}}>{{t 'lang.MY_WARDROBE'}}</option>
      {{#each sharedWardrobes}}
      <option value="/wardrobe?ownerId={{this.grantorId}}" {{#ifEquals ../viewOwner this.grantorId}}selected{{/ifEquals}}>{{this.grantorName}} ({{this.permission}})</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

  <p class="text-sm text-base-content/60 mb-4 px-2">{{garments.length}} {{t 'lang.RESULTS'}}</p>

  {{#if garments.length}}
  <div class="flex flex-wrap gap-4 justify-center">
    {{#each garments}}
    <a href="/wardrobe/{{this.id}}{{#if ../viewOwner}}?ownerId={{../viewOwner}}{{/if}}" class="card bg-base-100 w-40 sm:w-44 shadow-sm hover:shadow-md transition-shadow cursor-pointer {{#if this.archived}}opacity-50{{/if}}">
      <figure class="aspect-square bg-base-200 relative">
        {{#if this.photo}}
        <img src="/file/nobg/{{this.photo.fileName}}" alt="{{this.name}}" class="object-cover w-full h-full" />
        {{else}}
        <div class="flex items-center justify-center w-full h-full text-base-content/30">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-12">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.251 2.251 0 0 1 2.012 1.244l.256.512a2.251 2.251 0 0 0 2.013 1.244h3.218a2.251 2.251 0 0 0 2.013-1.244l.256-.512a2.251 2.251 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3" />
          </svg>
        </div>
        {{/if}}
        {{#if this.cost}}
        <span class="badge badge-sm badge-neutral absolute top-2 right-2 font-semibold shadow-sm">{{formatCurrency this.cost ../currency}}</span>
        {{/if}}
      </figure>
      <div class="card-body p-3">
        <h2 class="card-title text-sm truncate">{{this.name}}</h2>
        <div class="flex items-center justify-between mt-0.5">
          <p class="text-xs text-base-content/60 capitalize truncate">{{this.category}}{{#if this.subCategory}} &middot; {{this.subCategory}}{{/if}}</p>
          {{#if this.rating}}
          <span class="text-xs text-amber-500 font-bold ml-1 flex-shrink-0">★ {{this.rating}}</span>
          {{/if}}
        </div>
      </div>
    </a>
    {{/each}}
  </div>
  {{else}}
  <div class="flex flex-col items-center justify-center gap-4 pt-20 text-base-content/40">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-16">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.251 2.251 0 0 1 2.012 1.244l.256.512a2.251 2.251 0 0 0 2.013 1.244h3.218a2.251 2.251 0 0 0 2.013-1.244l.256-.512a2.251 2.251 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3" />
    </svg>
    <p>{{t 'lang.NO_GARMENTS'}}</p>
    {{#if canEdit}}
    <a href="/wardrobe/new{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-primary btn-sm">{{t 'lang.ADD_FIRST_GARMENT'}}</a>
    {{/if}}
  </div>
  {{/if}}
</main>

{{!-- Fixed bottom search + filter bar --}}
<div class="fixed bottom-[calc(4rem+env(safe-area-inset-bottom,0px))] left-0 right-0 bg-base-100 border-t border-base-300 z-20 px-4 pt-2 pb-2">

  {{!-- Filter & Sort buttons + active pills row --}}
  <div class="flex flex-wrap items-center gap-2 mb-2">
    <button type="button" _="on click call #filter-modal.showModal()"
      class="btn btn-ghost btn-xs gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
      </svg>
      {{t 'lang.FILTER_SEARCH'}}
    </button>

    <button type="button" _="on click call #sort-modal.showModal()"
      class="btn btn-ghost btn-xs gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5 7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
      </svg>
      {{t 'lang.SORT_BY'}}
    </button>

    {{#if activeSortLabel}}
    <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&subCategory={{search.subCategory}}&color={{search.color}}&size={{search.size}}&season={{search.season}}&occasion={{search.occasion}}&rating={{search.rating}}&archived={{search.archived}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}"
      class="badge badge-neutral badge-sm gap-1 cursor-pointer no-underline" title="{{t 'lang.CLEAR_SORT'}}">
      <span>{{activeSortLabel}}</span> &times;
    </a>
    {{/if}}

    {{#if search.category}}
    <a href="/wardrobe?keyword={{search.keyword}}&subCategory={{search.subCategory}}&color={{search.color}}&size={{search.size}}&season={{search.season}}&occasion={{search.occasion}}&rating={{search.rating}}&archived={{search.archived}}{{#if search.sortBy}}&sortBy={{search.sortBy}}{{/if}}{{#if search.sortOrder}}&sortOrder={{search.sortOrder}}{{/if}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}"
      class="badge badge-primary badge-sm gap-1 cursor-pointer capitalize no-underline">
      {{search.category}} &times;
    </a>
    {{/if}}
    {{#if search.subCategory}}
    <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&color={{search.color}}&size={{search.size}}&season={{search.season}}&occasion={{search.occasion}}&rating={{search.rating}}&archived={{search.archived}}{{#if search.sortBy}}&sortBy={{search.sortBy}}{{/if}}{{#if search.sortOrder}}&sortOrder={{search.sortOrder}}{{/if}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}"
      class="badge badge-accent badge-sm gap-1 cursor-pointer capitalize no-underline">
      {{search.subCategory}} &times;
    </a>
    {{/if}}
    {{#if search.color}}
    <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&subCategory={{search.subCategory}}&size={{search.size}}&season={{search.season}}&occasion={{search.occasion}}&rating={{search.rating}}&archived={{search.archived}}{{#if search.sortBy}}&sortBy={{search.sortBy}}{{/if}}{{#if search.sortOrder}}&sortOrder={{search.sortOrder}}{{/if}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}"
      class="badge badge-secondary badge-sm gap-1 cursor-pointer capitalize no-underline">
      {{search.color}} &times;
    </a>
    {{/if}}
    {{#if search.size}}
    <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&subCategory={{search.subCategory}}&color={{search.color}}&season={{search.season}}&occasion={{search.occasion}}&rating={{search.rating}}&archived={{search.archived}}{{#if search.sortBy}}&sortBy={{search.sortBy}}{{/if}}{{#if search.sortOrder}}&sortOrder={{search.sortOrder}}{{/if}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}"
      class="badge badge-accent badge-sm gap-1 cursor-pointer no-underline">
      {{search.size}} &times;
    </a>
    {{/if}}
    {{#if search.archived}}
    <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&subCategory={{search.subCategory}}&color={{search.color}}&size={{search.size}}&season={{search.season}}&occasion={{search.occasion}}&rating={{search.rating}}{{#if search.sortBy}}&sortBy={{search.sortBy}}{{/if}}{{#if search.sortOrder}}&sortOrder={{search.sortOrder}}{{/if}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}"
      class="badge badge-warning badge-sm gap-1 cursor-pointer no-underline">
      {{t 'lang.ARCHIVED'}} &times;
    </a>
    {{/if}}
    {{#if search.season}}
    <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&subCategory={{search.subCategory}}&color={{search.color}}&size={{search.size}}&archived={{search.archived}}&occasion={{search.occasion}}&rating={{search.rating}}{{#if search.sortBy}}&sortBy={{search.sortBy}}{{/if}}{{#if search.sortOrder}}&sortOrder={{search.sortOrder}}{{/if}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}"
      class="badge badge-info badge-sm gap-1 cursor-pointer no-underline">
      {{search.season}} &times;
    </a>
    {{/if}}
    {{#if search.occasion}}
    <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&subCategory={{search.subCategory}}&color={{search.color}}&size={{search.size}}&archived={{search.archived}}&season={{search.season}}&rating={{search.rating}}{{#if search.sortBy}}&sortBy={{search.sortBy}}{{/if}}{{#if search.sortOrder}}&sortOrder={{search.sortOrder}}{{/if}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}"
      class="badge badge-secondary badge-sm gap-1 cursor-pointer no-underline">
      {{search.occasion}} &times;
    </a>
    {{/if}}
    {{#if search.rating}}
    <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&subCategory={{search.subCategory}}&color={{search.color}}&size={{search.size}}&archived={{search.archived}}&season={{search.season}}&occasion={{search.occasion}}{{#if search.sortBy}}&sortBy={{search.sortBy}}{{/if}}{{#if search.sortOrder}}&sortOrder={{search.sortOrder}}{{/if}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}"
      class="badge badge-accent badge-sm gap-1 cursor-pointer no-underline">
      ★ {{search.rating}}+ &times;
    </a>
    {{/if}}
  </div>

  {{!-- Search input row --}}
  <form method="get" action="/wardrobe" id="search-form" class="flex gap-2">
    <input type="hidden" name="category" id="active-category" value="{{search.category}}">
    <input type="hidden" name="subCategory" id="active-subCategory" value="{{search.subCategory}}">
    <input type="hidden" name="color" id="active-color" value="{{search.color}}">
    <input type="hidden" name="size" id="active-size" value="{{search.size}}">
    <input type="hidden" name="archived" id="active-archived" value="{{search.archived}}">
    <input type="hidden" name="season" id="active-season" value="{{search.season}}">
    <input type="hidden" name="occasion" id="active-occasion" value="{{search.occasion}}">
    <input type="hidden" name="rating" id="active-rating" value="{{search.rating}}">
    <input type="hidden" name="sortBy" id="active-sortBy" value="{{search.sortBy}}">
    <input type="hidden" name="sortOrder" id="active-sortOrder" value="{{search.sortOrder}}">
    {{#if viewOwner}}<input type="hidden" name="ownerId" value="{{viewOwner}}">{{/if}}
    <input
      type="text"
      name="keyword"
      value="{{search.keyword}}"
      placeholder="{{t 'lang.SEARCH_PLACEHOLDER'}}"
      class="input input-bordered input-sm flex-1"
    />
    <button type="submit" class="btn btn-primary btn-sm">{{t 'lang.SEARCH'}}</button>
  </form>
</div>

{{!-- Filter modal --}}
<dialog id="filter-modal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box">
    <h3 class="font-bold text-lg mb-4">{{t 'lang.FILTERS'}}</h3>

    {{!-- Category --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.CATEGORY'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each availableCategories}}
        <label class="cursor-pointer">
          <input type="radio" name="modal-category" value="{{this.value}}" class="hidden peer"
            {{#ifEquals this.value ../search.category}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-primary capitalize select-none">{{this.label}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{!-- Sub-category --}}
    <div class="mb-5" id="modal-subcategory-group">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.SUB_CATEGORY'}}</h4>
      <div class="flex flex-wrap gap-2" id="modal-subcategories-list">
        {{#each availableSubCategories}}
        <label class="cursor-pointer modal-subcat-item">
          <input type="radio" name="modal-subCategory" value="{{this}}" class="hidden peer"
            {{#ifEquals this ../search.subCategory}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-accent select-none">{{this}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{!-- Color --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.COLOR'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each colors}}
        <label class="cursor-pointer">
          <input type="radio" name="modal-color" value="{{this}}" class="hidden peer"
            {{#ifEquals this ../search.color}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-secondary capitalize select-none">{{this}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{!-- Size --}}
    {{#if availableSizes.length}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.SIZE'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each availableSizes}}
        <label class="cursor-pointer">
          <input type="radio" name="modal-size" value="{{this}}" class="hidden peer"
            {{#ifEquals this ../search.size}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-accent select-none">{{this}}</span>
        </label>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{!-- Season --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.SEASONS'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each availableSeasons}}
        <label class="cursor-pointer">
          <input type="radio" name="modal-season" value="{{this}}" class="hidden peer"
            {{#ifEquals this ../search.season}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-info select-none">{{this}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{!-- Occasion --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.OCCASIONS'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each availableOccasions}}
        <label class="cursor-pointer">
          <input type="radio" name="modal-occasion" value="{{this}}" class="hidden peer"
            {{#ifEquals this ../search.occasion}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-secondary select-none">{{this}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{!-- Rating --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.RATING'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each ratingOptions}}
        <label class="cursor-pointer">
          <input type="radio" name="modal-rating" value="{{this}}" class="hidden peer"
            {{#ifEquals this ../search.rating}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-warning select-none">★ {{this}} & up</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{!-- Archived --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.ARCHIVED'}}</h4>
      <label class="cursor-pointer flex items-center gap-2">
        <input type="checkbox" name="modal-archived" value="true" class="checkbox checkbox-sm"
          {{#if search.archived}}checked{{/if}}>
        <span class="text-sm">{{t 'lang.SHOW_ARCHIVED'}}</span>
      </label>
    </div>

    <div class="modal-action">
      <button type="button"
        class="btn btn-ghost btn-sm"
        _="on click
          for el in <input[name='modal-category']/>
            set el.checked to false
          end
          for el in <input[name='modal-subCategory']/>
            set el.checked to false
          end
          for el in <input[name='modal-color']/>
            set el.checked to false
          end
          for el in <input[name='modal-size']/>
            set el.checked to false
          end
          for el in <input[name='modal-season']/>
            set el.checked to false
          end
          for el in <input[name='modal-occasion']/>
            set el.checked to false
          end
          for el in <input[name='modal-rating']/>
            set el.checked to false
          end
          for el in <input[name='modal-archived']/>
            set el.checked to false
          end
          set #active-category.value to ''
          set #active-subCategory.value to ''
          set #active-color.value to ''
          set #active-size.value to ''
          set #active-season.value to ''
          set #active-occasion.value to ''
          set #active-rating.value to ''
          set #active-archived.value to ''
          call #filter-modal.close()
          call #search-form.submit()">
        {{t 'lang.CLEAR_FILTERS'}}
      </button>
      <button type="button"
        class="btn btn-primary btn-sm"
        _="on click
          set category to ''
          get the first <input[name='modal-category']:checked/>
          if it then set category to it.value end
          set subCategory to ''
          get the first <input[name='modal-subCategory']:checked/>
          if it then set subCategory to it.value end
          set color to ''
          get the first <input[name='modal-color']:checked/>
          if it then set color to it.value end
          set size to ''
          get the first <input[name='modal-size']:checked/>
          if it then set size to it.value end
          set season to ''
          get the first <input[name='modal-season']:checked/>
          if it then set season to it.value end
          set occasion to ''
          get the first <input[name='modal-occasion']:checked/>
          if it then set occasion to it.value end
          set rating to ''
          get the first <input[name='modal-rating']:checked/>
          if it then set rating to it.value end
          set archived to ''
          get the first <input[name='modal-archived']:checked/>
          if it then set archived to 'true' end
          set #active-category.value to category
          set #active-subCategory.value to subCategory
          set #active-color.value to color
          set #active-size.value to size
          set #active-season.value to season
          set #active-occasion.value to occasion
          set #active-rating.value to rating
          set #active-archived.value to archived
          call #filter-modal.close()
          call #search-form.submit()">
        {{t 'lang.APPLY_FILTERS'}}
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

{{!-- Sort modal --}}
<dialog id="sort-modal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box max-h-[85vh] overflow-y-auto">
    <h3 class="font-bold text-lg mb-4">{{t 'lang.SORT_BY'}}</h3>

    {{!-- Property selection --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.PROPERTIES'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each sortPropertyOptions}}
        <label class="cursor-pointer modal-sort-prop-item">
          <input type="radio" name="modal-sortBy" value="{{this.key}}" class="hidden peer"
            {{#ifEquals this.key ../currentSortBy}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-primary select-none py-3 px-3.5">{{this.label}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{!-- Direction selection --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.SORT_DIRECTION'}}</h4>
      <div class="flex flex-col gap-2">
        <label class="cursor-pointer flex items-center gap-2.5 p-2.5 rounded-lg border border-base-200 hover:bg-base-200/50 has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-all">
          <input type="radio" name="modal-sortOrder" value="asc" class="radio radio-sm radio-primary"
            {{#ifEquals currentSortOrder 'asc'}}checked{{/ifEquals}}>
          <span class="text-sm font-medium">{{t 'lang.SORT_ASC'}}</span>
        </label>
        <label class="cursor-pointer flex items-center gap-2.5 p-2.5 rounded-lg border border-base-200 hover:bg-base-200/50 has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-all">
          <input type="radio" name="modal-sortOrder" value="desc" class="radio radio-sm radio-primary"
            {{#ifEquals currentSortOrder 'desc'}}checked{{/ifEquals}}>
          <span class="text-sm font-medium">{{t 'lang.SORT_DESC'}}</span>
        </label>
      </div>
    </div>

    <div class="modal-action flex justify-between mt-6">
      <button type="button" class="btn btn-ghost btn-sm"
        _="on click
          set #active-sortBy.value to ''
          set #active-sortOrder.value to ''
          call #sort-modal.close()
          call #search-form.submit()">
        {{t 'lang.CLEAR_SORT'}}
      </button>
      <button type="button" class="btn btn-primary btn-sm"
        _="on click
          set sortBy to 'recently_added'
          get the first <input[name='modal-sortBy']:checked/>
          if it then set sortBy to it.value end
          set sortOrder to 'asc'
          get the first <input[name='modal-sortOrder']:checked/>
          if it then set sortOrder to it.value end
          set #active-sortBy.value to sortBy
          set #active-sortOrder.value to sortOrder
          call #sort-modal.close()
          call #search-form.submit()">
        {{t 'lang.APPLY_SORT'}}
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  (function () {
    const descDefaults = ['rating', 'recently_added', 'dateAquired'];
    document.querySelectorAll('input[name="modal-sortBy"]').forEach((input) => {
      input.addEventListener('change', () => {
        const val = input.value;
        const targetOrder = descDefaults.includes(val) ? 'desc' : 'asc';
        const orderInput = document.querySelector('input[name="modal-sortOrder"][value="' + targetOrder + '"]');
        if (orderInput) orderInput.checked = true;
      });
    });
  })();
</script>

<script>
  (function () {
    let subcatsMap = {};
    try {
      subcatsMap = {{{subcategoriesJson}}};
    } catch (e) {
      console.warn('Could not parse subcategories map', e);
    }
    const allWardrobeSubcats = [{{#each availableSubCategories}}"{{this}}",{{/each}}];
    const initialSubCategory = "{{search.subCategory}}";

    function getSelectedCategory() {
      const checked = document.querySelector('input[name="modal-category"]:checked');
      return checked ? checked.value.toLowerCase().trim() : '';
    }

    function renderSubcategories() {
      const selectedCat = getSelectedCategory();
      const listEl = document.getElementById('modal-subcategories-list');
      if (!listEl) return;

      let subcatNames = [];
      if (selectedCat && subcatsMap[selectedCat]) {
        subcatNames = subcatsMap[selectedCat];
      } else if (!selectedCat) {
        subcatNames = allWardrobeSubcats;
      }

      const currentCheckedEl = document.querySelector('input[name="modal-subCategory"]:checked');
      const currentVal = currentCheckedEl ? currentCheckedEl.value : initialSubCategory;

      listEl.innerHTML = '';
      if (!subcatNames || subcatNames.length === 0) {
        const span = document.createElement('span');
        span.className = 'text-xs text-base-content/50 italic py-1';
        span.textContent = selectedCat
          ? '{{t "lang.NO_PREDEFINED_SUBCATEGORIES"}}'
          : '{{t "lang.SELECT_CATEGORY_FIRST"}}';
        listEl.appendChild(span);
        return;
      }

      subcatNames.forEach((name) => {
        const label = document.createElement('label');
        label.className = 'cursor-pointer modal-subcat-item';

        const radio = document.createElement('input');
        radio.type = 'radio';
        radio.name = 'modal-subCategory';
        radio.value = name;
        radio.className = 'hidden peer';
        if (currentVal && name.toLowerCase() === currentVal.toLowerCase()) {
          radio.checked = true;
        }

        const badge = document.createElement('span');
        badge.className = 'badge badge-outline peer-checked:badge-accent select-none';
        badge.textContent = name;

        label.appendChild(radio);
        label.appendChild(badge);
        listEl.appendChild(label);
      });
    }

    document.querySelectorAll('input[name="modal-category"]').forEach((el) => {
      el.addEventListener('change', renderSubcategories);
    });

    renderSubcategories();
  })();
</script>

{{>dock}}

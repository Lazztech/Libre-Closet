{{!-- HTMX partial: shown after invite link creation --}}
<div class="flex flex-col gap-3" id="invite-link-result">
  <div class="flex items-center gap-2">
    <input
      type="text"
      class="input input-bordered input-sm flex-1"
      value="{{inviteUrl}}"
      readonly
      onclick="this.select()"
    />
    <button
      class="btn btn-primary btn-sm"
      onclick="copyText('{{inviteUrl}}'); alert('{{t 'lang.COPIED'}}')"
    >{{t 'lang.COPY_TEXT'}}</button>
  </div>
</div>
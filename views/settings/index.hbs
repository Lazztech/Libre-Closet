{{>navbar}}

<main class="p-4 pt-20 pb-24 max-w-5xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="/" class="btn btn-ghost btn-sm">←</a>
    <h1 class="text-2xl font-bold">Canvas settings</h1>
  </div>

  <div class="grid lg:grid-cols-[220px_1fr] gap-8">
    <section>
      <h2 class="font-semibold mb-3">Mannequin</h2>
      <div class="flex justify-center p-4 rounded-box bg-base-200 border border-base-300">
        <img src="{{mannequinUrl}}" class="w-[100px] h-[200px] object-contain" alt="Mannequin preview"
          onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden')" />
        <div class="hidden text-xs text-base-content/50 text-center">No mannequin uploaded</div>
      </div>
      <form action="/settings/mannequin" method="post" enctype="multipart/form-data" class="mt-3">
        <input type="file" name="mannequin" accept="image/png" class="file-input file-input-bordered file-input-sm w-full" required />
        <button class="btn btn-primary btn-sm w-full mt-2">Upload mannequin.png</button>
      </form>
      <p class="text-xs text-base-content/50 mt-2">PNG with transparency recommended. This image is used behind every canvas.</p>
    </section>

    <section>
      <h2 class="font-semibold mb-1">Default garment placement</h2>
      <p class="text-sm text-base-content/60 mb-4">These defaults are used when a garment is first created or added to an outfit. Canvas coordinates use 0–1000.</p>

      <form action="/settings" method="post">
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead><tr><th>Category</th><th>X</th><th>Y</th><th>Rotation</th><th>Scale</th><th>Layer</th></tr></thead>
            <tbody>
              {{#each categories}}
              <tr>
                <th>{{label}}</th>
                <td><input class="input input-bordered input-sm w-24" type="number" name="{{value}}__x" value="{{setting.x}}" step="1" min="0" max="1000" /></td>
                <td><input class="input input-bordered input-sm w-24" type="number" name="{{value}}__y" value="{{setting.y}}" step="1" min="0" max="1000" /></td>
                <td><input class="input input-bordered input-sm w-24" type="number" name="{{value}}__rotation" value="{{setting.rotation}}" step="1" /></td>
                <td><input class="input input-bordered input-sm w-24" type="number" name="{{value}}__scale" value="{{setting.scale}}" step="0.05" min="0.05" max="5" /></td>
                <td><input class="input input-bordered input-sm w-24" type="number" name="{{value}}__zIndex" value="{{setting.zIndex}}" step="1" /></td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        <div class="flex justify-end mt-4"><button class="btn btn-primary">Save settings</button></div>
      </form>
    </section>
  </div>
</main>

{{>dock}}

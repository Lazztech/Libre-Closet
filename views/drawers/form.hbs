{{>navbar}}

<main class="p-4 pt-20 pb-24 sm:max-w-lg sm:mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a
      href="{{#if drawer}}/drawers/{{drawer.id}}{{else}}/drawers{{/if}}"
      class="btn btn-ghost btn-sm btn-circle"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="size-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
        />
      </svg>
    </a>
    <h1 class="text-2xl font-bold">
      {{#if drawer}}{{t 'lang.EDIT_DRAWER'}}{{else}}{{t
      'lang.NEW_DRAWER'}}{{/if}}
    </h1>
  </div>

  <form
    method="POST"
    action="{{#if drawer}}/drawers/{{drawer.id}}{{else}}/drawers{{/if}}"
    class="flex flex-col gap-4"
  >
    <div class="form-control">
      <label class="label"
        ><span class="label-text">{{t 'lang.NAME'}} *</span></label
      >
      <input
        type="text"
        name="name"
        class="input input-bordered w-full"
        value="{{#if drawer}}{{drawer.name}}{{/if}}"
        required
        placeholder="e.g. Winter Coats"
      />
    </div>

    <div class="form-control">
      <label class="label"
        ><span class="label-text">{{t 'lang.NOTES'}}</span></label
      >
      <textarea
        name="notes"
        class="textarea textarea-bordered w-full"
        rows="2"
      >
{{#if drawer}}{{drawer.notes}}{{/if}}</textarea
      >
    </div>

    <div class="form-control">
      <label class="label"
        ><span class="label-text"
          >{{t 'lang.GARMENTS_IN_DRAWER'}}</span
        ></label
      >
      {{#if garments.length}}
      <div
        class="grid grid-cols-3 sm:grid-cols-4 gap-2 max-h-96 overflow-y-auto p-1 border border-base-300 rounded-box"
      >
        {{#each garments}}
        <label class="cursor-pointer flex flex-col items-center gap-1">
          <input
            type="checkbox"
            name="garmentId"
            value="{{this.id}}"
            class="hidden peer"
            {{#ifContains ../selectedGarmentIds this.id}}checked{{/ifContains}}
          />
          <div
            class="size-16 rounded-box bg-base-200 overflow-hidden ring-2 ring-transparent peer-checked:ring-primary"
          >
            {{#if this.photo}}
            <img
              src="/file/nobg/{{this.photo.fileName}}"
              alt="{{this.name}}"
              class="w-full h-full object-cover"
            />
            {{else}}
            <div
              class="w-full h-full flex items-center justify-center text-base-content/30"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.251 2.251 0 0 1 2.012 1.244l.256.512a2.251 2.251 0 0 0 2.013 1.244h3.218a2.251 2.251 0 0 0 2.013-1.244l.256-.512a2.251 2.251 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3"
                />
              </svg>
            </div>
            {{/if}}
          </div>
          <span class="text-xs text-center line-clamp-2 leading-tight"
            >{{this.name}}</span
          >
        </label>
        {{/each}}
      </div>
      {{else}}
      <p class="text-sm text-base-content/40 italic">
        {{t 'lang.NO_GARMENTS_FOR_DRAWER'}}
      </p>
      {{/if}}
    </div>

    <div class="flex gap-2 mt-2">
      <button type="submit" class="btn btn-primary flex-1">
        {{t 'lang.SAVE'}}
      </button>
      <a
        href="{{#if drawer}}/drawers/{{drawer.id}}{{else}}/drawers{{/if}}"
        class="btn btn-ghost"
        >{{t 'lang.CANCEL'}}</a
      >
    </div>
  </form>
</main>

{{>dock}}

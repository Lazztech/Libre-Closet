{{>navbar}}

<main class="p-4 pt-20 pb-24 sm:max-w-lg sm:mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a
      href="{{#if drawer}}/drawers/{{drawer.id}}{{else}}/drawers{{/if}}"
      class="btn btn-ghost btn-sm btn-circle"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="size-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
        />
      </svg>
    </a>
    <h1 class="text-2xl font-bold">
      {{#if drawer}}{{t 'lang.EDIT_DRAWER'}}{{else}}{{t
      'lang.NEW_DRAWER'}}{{/if}}
    </h1>
  </div>

  <form
    method="POST"
    action="{{#if drawer}}/drawers/{{drawer.id}}{{else}}/drawers{{/if}}"
    class="flex flex-col gap-4"
  >
    <div class="form-control">
      <label class="label"
        ><span class="label-text">{{t 'lang.NAME'}} *</span></label
      >
      <input
        type="text"
        name="name"
        class="input input-bordered w-full"
        value="{{#if drawer}}{{drawer.name}}{{/if}}"
        required
        placeholder="e.g. Winter Coats"
      />
    </div>

    <div class="form-control">
      <label class="label"
        ><span class="label-text">{{t 'lang.NOTES'}}</span></label
      >
      <textarea
        name="notes"
        class="textarea textarea-bordered w-full"
        rows="2"
      >
{{#if drawer}}{{drawer.notes}}{{/if}}</textarea
      >
    </div>

    <div class="form-control">
      <div class="flex items-center justify-between label pb-1">
        <span class="label-text">{{t 'lang.GARMENTS_IN_DRAWER'}}</span>
        <span
          id="picker-selected-count"
          class="text-xs text-base-content/50"
          >{{selectedGarmentIds.length}} {{t 'lang.SELECTED'}}</span
        >
      </div>
      {{#if total}}
      <div class="flex flex-col sm:flex-row gap-2 mb-2">
        <input
          type="text"
          id="picker-search"
          name="keyword"
          placeholder="{{t 'lang.SEARCH_PLACEHOLDER'}}"
          autocomplete="off"
          class="input input-bordered input-sm w-full sm:flex-1 min-w-0"
        />
        <select
          id="picker-category"
          name="category"
          class="select select-bordered select-sm w-full sm:w-40 sm:shrink-0"
        >
          <option value="">{{t 'lang.ALL_CATEGORIES'}}</option>
          {{#each categories}}
          <option value="{{this.value}}">{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div
        id="garment-picker-grid"
        class="max-h-96 overflow-y-auto p-1 border border-base-300 rounded-box"
        hx-get="/drawers/picker"
        hx-trigger="input changed delay:300ms from:#picker-search, change from:#picker-category"
        hx-include="#picker-search, #picker-category, .selected-hidden"
        hx-swap="innerHTML"
      >
        {{> garment_picker_grid garments=garments selectedGarmentIds=selectedGarmentIds page=page totalPages=totalPages showPagination=showPagination hasPrevPage=hasPrevPage hasNextPage=hasNextPage prevPageUrl=prevPageUrl nextPageUrl=nextPageUrl}}
      </div>
      <div id="selected-inputs">
        {{#each selectedGarments}}
        <input
          type="hidden"
          name="garmentId"
          class="selected-hidden"
          value="{{this.id}}"
          data-name="{{this.name}}"
        />
        {{/each}}
      </div>
      {{else}}
      <p class="text-sm text-base-content/40 italic">
        {{t 'lang.NO_GARMENTS_FOR_DRAWER'}}
      </p>
      {{/if}}
    </div>

    <script>
      (function () {
        var grid = document.getElementById('garment-picker-grid');
        var selectedInputs = document.getElementById('selected-inputs');
        var counter = document.getElementById('picker-selected-count');
        if (!grid || !selectedInputs) return;

        function updateCounter() {
          var count = selectedInputs.querySelectorAll('.selected-hidden').length;
          if (counter) counter.textContent = count + ' {{t "lang.SELECTED"}}';
        }

        function addSelected(id, name) {
          if (selectedInputs.querySelector('.selected-hidden[value="' + id + '"]'))
            return;
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'garmentId';
          input.className = 'selected-hidden';
          input.value = id;
          input.dataset.name = name || '';
          selectedInputs.appendChild(input);
        }

        function removeSelected(id) {
          var existing = selectedInputs.querySelector(
            '.selected-hidden[value="' + id + '"]',
          );
          if (existing) existing.remove();
        }

        grid.addEventListener('change', function (event) {
          var checkbox = event.target.closest('.picker-checkbox');
          if (!checkbox) return;
          var card = checkbox.closest('.garment-card');
          var id = checkbox.value;
          if (checkbox.checked) {
            addSelected(id, card && card.dataset.name);
          } else {
            removeSelected(id);
          }
          updateCounter();
        });

        updateCounter();
      })();
    </script>

    <div class="flex gap-2 mt-2">
      <button type="submit" class="btn btn-primary flex-1">
        {{t 'lang.SAVE'}}
      </button>
      <a
        href="{{#if drawer}}/drawers/{{drawer.id}}{{else}}/drawers{{/if}}"
        class="btn btn-ghost"
        >{{t 'lang.CANCEL'}}</a
      >
    </div>
  </form>
</main>

{{>dock}}

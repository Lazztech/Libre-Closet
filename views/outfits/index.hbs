{{>navbar}}

<main class="p-4 pt-20 pb-24">
  <div class="flex items-center justify-between mb-6 px-2">
    <h1 class="text-2xl font-bold">{{t 'lang.OUTFITS'}}</h1>
    <a href="/outfits/new" class="btn btn-primary btn-sm"
      >+ {{t 'lang.BUILD_OUTFIT'}}</a
    >
  </div>

  {{#if outfitCards.length}}
  <div class="grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-4 w-full max-w-7xl mx-auto">
    {{#each outfitCards}}
    <div
      class="card bg-base-100 w-full min-w-0 shadow-sm hover:shadow-md transition-shadow overflow-hidden"
    >
      <div class="card-body p-3 cursor-pointer" onclick="window.location = '/outfits/{{this.outfit.id}}'">
        <div class="flex items-center justify-between gap-2">
          <a href="/outfits/{{this.outfit.id}}" class="card-title text-sm hover:underline truncate">{{this.outfit.name}}</a>
          <div class="dropdown dropdown-end shrink-0" onclick="event.stopPropagation();">
            <label tabindex="0" class="btn btn-ghost btn-xs btn-square" title="{{t 'lang.ADD_TO_CALENDAR'}}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5a2.25 2.25 0 0 1 2.25 2.25v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
              </svg>
            </label>
            <div tabindex="0" class="dropdown-content z-10 card card-compact shadow-lg bg-base-100 border border-base-300 w-64 mt-1">
              <div class="card-body p-4 gap-3">
                <p class="font-semibold text-sm">{{t 'lang.CALENDAR_ADD_OUTFIT_PROMPT'}}</p>
                <form
                  hx-post="/calendar"
                  hx-swap="none"
                  hx-push-url="false"
                  _="on htmx:afterRequest[detail.successful]
                    reset me
                    call document.activeElement.blur()
                    for el in <[tabindex]/> in closest .dropdown
                      call el.blur()
                    end
                    remove .hidden from #calendar-toast
                    wait 3s
                    add .hidden to #calendar-toast"
                  class="flex flex-col gap-2"
                >
                  <input type="hidden" name="outfitId" value="{{this.outfit.id}}" />
                  <input
                    type="date"
                    name="date"
                    class="input input-sm input-bordered w-full"
                    required
                    onblur="this.closest('form').querySelector('[type=submit]').focus()"
                  />
                  <button type="submit" class="btn btn-primary btn-sm w-full">{{t 'lang.SAVE'}}</button>
                </form>
              </div>
            </div>
          </div>
        </div>

        {{#if this.outfit.notes}}
        <p class="text-xs text-base-content/60 line-clamp-2">{{this.outfit.notes}}</p>
        {{/if}}

        <div
          class="outfit-preview relative mt-1 w-[100px] h-[200px] mx-auto overflow-hidden rounded-box bg-base-200"
          aria-label="{{this.outfit.name}}"
        >
          <img
            src="/settings/mannequin"
            alt=""
            aria-hidden="true"
            class="absolute inset-0 z-0 w-full h-full object-contain pointer-events-none select-none"
            draggable="false"
            onerror="this.style.display='none'"
          />
          {{#if this.canvasGarments.length}}
          {{#each this.canvasGarments}}
          <div
            class="outfit-preview-item absolute left-0 top-0 w-[72%]"
            style="left: calc({{position.x}} / 10 * 1%); top: calc({{position.y}} / 10 * 1%); z-index: {{zIndex}}; transform: translate(-50%, -50%) rotate({{rotation}}deg) scale({{scale}}); transform-origin: center center;"
          >
            {{#if garment.photo}}
            <img
              src="/file/nobg/{{garment.photo.fileName}}"
              alt="{{garment.name}}"
              class="block w-full h-auto pointer-events-none select-none"
              draggable="false"
            />
            {{else}}
            <div class="aspect-square rounded-box bg-base-300 flex items-center justify-center text-xs text-base-content/40 text-center p-2">
              {{garment.name}}
            </div>
            {{/if}}
          </div>
          {{/each}}
          {{else}}
          <div class="absolute inset-0 flex items-center justify-center text-sm text-base-content/30">
            {{t 'lang.NO_GARMENTS'}}
          </div>
          {{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div
    class="flex flex-col items-center justify-center gap-4 pt-20 text-base-content/40"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1"
      stroke="currentColor"
      class="size-16"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12"
      />
    </svg>
    <p>{{t 'lang.NO_OUTFITS'}}</p>
    <a href="/outfits/new" class="btn btn-primary btn-sm"
      >{{t 'lang.ADD_FIRST_OUTFIT'}}</a
    >
  </div>
  {{/if}}
</main>

<div id="calendar-toast" class="toast toast-top toast-center hidden z-20 top-20" aria-live="polite">
  <div class="alert alert-success shadow-md">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span>{{t 'lang.CALENDAR_OUTFIT_ADDED'}}</span>
  </div>
</div>

{{>dock}}

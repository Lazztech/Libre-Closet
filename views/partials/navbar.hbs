{{!--
https://daisyui.com/components/drawer/#navbar-menu-for-desktop--sidebar-drawer-for-mobile
--}}
<div class="drawer navbar">
  <input id="my-drawer-2" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content flex flex-col">
    <!-- Navbar -->
    <div class="navbar bg-base-300 w-full">
      <div class="flex-none lg:hidden">
        <label
          for="my-drawer-2"
          aria-label="open sidebar"
          class="btn btn-square btn-ghost"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            class="inline-block h-6 w-6 stroke-current"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
        </label>
      </div>
      <a class="mx-2 flex flex-row gap-2 pt-1" href="/">
        <img
          src="/assets/lazztech_title.svg"
          alt="Lazztech"
          class="h-6 w-auto theme-invert"
          width="1370"
          height="356"
          fetchpriority="high"
        />
        <span class="text-lg">| {{appName}}</span>
        <div class="relative size-6">
          <div id="offline-indicator" class="absolute inset-0">
            <span
              id="loading"
              class="htmx-indicator loading loading-ring loading-sm"
            ></span>
          </div>
        </div>
      </a>
      <div class="flex-none ml-auto flex items-center gap-1">
        <button
          type="button"
          class="btn btn-ghost btn-sm btn-circle theme-toggle-btn"
          onclick="window.toggleTheme && window.toggleTheme()"
          aria-label="{{t 'lang.TOGGLE_THEME'}}"
          title="{{t 'lang.TOGGLE_THEME'}}"
        >
          <!-- Sun icon (shown in dark theme) -->
          <svg class="size-5 hidden [html[data-theme=dark]_&]:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
          </svg>
          <!-- Moon icon (shown in light theme) -->
          <svg class="size-5 block [html[data-theme=dark]_&]:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </button>
        <div class="hidden lg:block pt-1">
          <ul class="menu menu-horizontal">
            <!-- Navbar menu content here -->
            {{#if showSupporterPrompt}}
            <li>
              <a
                href="https://ko-fi.com/lazztech"
                target="_blank"
                rel="noopener"
                _="on click call #supporter-modal.showModal() then halt"
                >❤ {{t 'lang.SUPPORT'}}</a
              >
            </li>
            {{/if}} {{#if authEnabled}} {{#if user}}
            <li><a href="/auth/logout">{{t 'lang.LOGOUT'}}</a></li>
            <li><a href="/auth/profile">{{user.email}}</a></li>
            {{else}} {{#unless signupsDisabled}}
            <li><a href="/auth/register">{{t 'lang.REGISTER'}}</a></li>
            {{/unless}}
            <li><a href="/auth/login">{{t 'lang.LOGIN'}}</a></li>
            {{/if}} {{/if}}
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="drawer-side pt-16">
    <label
      for="my-drawer-2"
      aria-label="close sidebar"
      class="drawer-overlay"
    ></label>
    <ul class="menu bg-base-200 min-h-full w-80 p-4 pt-8">
      <!-- Sidebar content here -->
      <li>
        <a href="javascript:void(0)" onclick="window.toggleTheme && window.toggleTheme()" class="flex items-center gap-2">
          <span class="[html[data-theme=dark]_&]:hidden">🌙 {{t 'lang.THEME_DARK'}}</span>
          <span class="hidden [html[data-theme=dark]_&]:inline">☀️ {{t 'lang.THEME_LIGHT'}}</span>
        </a>
      </li>
      {{#if showSupporterPrompt}}
      <li>
        <a
          href="https://ko-fi.com/lazztech"
          target="_blank"
          rel="noopener"
          _="on click call #supporter-modal.showModal() then halt"
          >❤ {{t 'lang.SUPPORT'}}</a
        >
      </li>
      {{/if}} {{#if authEnabled}} {{#if user}}
      <li><a href="/auth/logout">{{t 'lang.LOGOUT'}}</a></li>
      <li><a href="/auth/profile">{{user.email}}</a></li>
      {{else}} {{#unless signupsDisabled}}
      <li><a href="/auth/register">{{t 'lang.REGISTER'}}</a></li>
      {{/unless}}
      <li><a href="/auth/login">{{t 'lang.LOGIN'}}</a></li>
      {{/if}} {{/if}}
    </ul>
  </div>
</div>
